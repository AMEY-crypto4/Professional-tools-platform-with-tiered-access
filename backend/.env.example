# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev: a local Postgres instance. Production: any standard Postgres
# connection string (Supabase, Neon, Railway, RDS all work).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aacreations

# --- Auth --------------------------------------------------------------------
# Generate a real random string for this — e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated emails that always get unlimited/free access to every tool
# at the highest tier, regardless of what's in the subscriptions table — this
# is how the platform owner (you) uses everything for free. Checked at
# signup AND on every login, so adding an email here upgrades that account
# the next time it signs in — no manual DB edit needed.
#
# Use an email that's specific to this side business, not one tied to any
# other brand/work identity — this account gets full platform ownership.
OWNER_EMAILS=you@example.com

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your frontend URLs)
CORS_ORIGINS=http://localhost:8080,http://localhost:4000

# --- Billing (Razorpay and/or Stripe) -----------------------------------------
# Safe to leave both unset while building — /api/billing/* returns a clear
# "not configured" error instead of crashing, and every tool still works on
# its free tier with no payment account at all.
#
# If both are set, Razorpay is used unless you force one with:
# PAYMENT_PROVIDER=razorpay   # or: stripe
#
# Where checkout sends the user back after paying/cancelling (Stripe redirect,
# and Razorpay's frontend page after its widget closes):
# FRONTEND_URL=http://localhost:8080

# Razorpay — the practical option for India-based accounts (no invite
# needed, unlike Stripe — see docs/ROADMAP.md). From
# https://dashboard.razorpay.com/app/keys (test mode keys to start — test
# mode is free, only live-mode charges cost anything):
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Webhook secret you set yourself in Dashboard -> Account & Settings ->
# Webhooks when you create the endpoint (not from Razorpay — you invent this
# value and enter it in both places):
# RAZORPAY_WEBHOOK_SECRET=...

# Stripe — only usable once you have a Stripe account; new India-based
# merchants currently need an invite (see docs/ROADMAP.md). From
# https://dashboard.stripe.com (test mode keys to start):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      (from the CLI: `stripe listen --print-secret`,
#                                        or from the webhook endpoint you create
#                                        in the Stripe Dashboard for production)
